{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "scripts/**/*.{ts,cjs,mjs,js}",
    "src/**/*.test.{ts,tsx}"
  ],
  "project": [
    "src/**/*.{ts,tsx}"
  ],
  "ignore": [
    "src/types/database.ts",
    "src/components/finance/OfrecerArregloButton.tsx"
  ],
  "ignoreDependencies": [],
  "ignoreExportsUsedInFile": true,
  "rules": {
    "duplicates": "off"
  }
}

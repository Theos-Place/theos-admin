# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# Clave pública (publishable / anon). El código acepta ambos nombres.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave de servicio (secret / service_role) — solo server-side, nunca exponer al cliente.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Solo para migraciones / scripts locales
SUPABASE_DB_PASSWORD=
SUPABASE_ACCESS_TOKEN=

# Contraseña para los usuarios de prueba creados por scripts/seed-test-users.ts.
# Nunca se hardcodea en el código; definila acá (local) o como variable de entorno.
SEED_TEST_PASSWORD=
